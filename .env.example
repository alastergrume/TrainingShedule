# Database
DATABASE_URL=postgresql://user:password@localhost:5432/training_schedule

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery (должны совпадать с Redis в Docker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_username
TELEGRAM_ADMIN_IDS=123456789,987654321

# VK
VK_GROUP_TOKEN=your_vk_group_token
VK_GROUP_ID=123456789
VK_CONFIRMATION_CODE=your_confirmation_code
VK_SECRET_KEY=your_secret_key

# Application
DEBUG=true
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=8000

# Reminders
REMINDER_MINUTES_BEFORE=60
ADMIN_NOTIFICATION_ENABLED=true

# Mini App (публичный HTTPS URL — используйте ngrok для локальной разработки)
MINIAPP_URL=https://your-domain.com
